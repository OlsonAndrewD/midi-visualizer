{
    "fps": 30,
    "noteApproachTime": 1000,
    "midiFileName": "test-data/drum test.mid",
    "width": 1280,
    "height": 720,
    "backgroundColor": "black",
    "flyIn": {
        "type": "3d",
        "shape": "bezierCurve",
        "startingPoint": {
            "x": 0.5,
            "y": 0.5
        }
    },
    "particles": {
        "perFrame": 50
    },
    "noteMap": {
        "33": "drum 1",
        "34": "drum 2",
        "35": "drum 3"
    },
    "colorizer": {
        "type": "byNote",
        "defaultColor": "white",
        "noteColors": {
            "drum 1": "red",
            "drum 2": "green",
            "drum 3": "cyan"
        }
    },
    "visualizer": {
        "type": "drumPads",
        "padHeight": 200,
        "padY": 0,
        "padOrder": [
            ["drum 1", "drum 2"],
            ["drum 3"]
        ],
        "impactSize": 75
    }
}