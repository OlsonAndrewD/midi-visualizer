{
  "name": "midi-visualizer",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "mpeg30": "ffmpeg -y -f image2 -framerate 30 -i frames/frame%07d.png -pix_fmt yuv420p video.mp4",
    "mpeg60": "ffmpeg -y -f image2 -framerate 60 -i frames/frame%07d.png -pix_fmt yuv420p video.mp4",
    "mov30": "ffmpeg -y -f image2 -framerate 30 -i frames/frame%07d.png -pix_fmt yuv420p video.mov",
    "mov60": "ffmpeg -y -f image2 -framerate 60 -i frames/frame%07d.png -pix_fmt yuv420p video.mov",
    "offset-timing-mpeg": "ffmpeg -y -i video.mp4 -itsoffset 3.12 -i video.mp4 -map 0:v -map 1:a -c copy video.mp4",
    "offset-timing-mov": "ffmpeg -y -i video.mov -itsoffset 2 -i video.mov -map 0:v -map 1:a -c copy video.mov",
    "test": "jest --watch"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^27.4.0",
    "jest": "^27.5.1"
  },
  "dependencies": {
    "canvas": "^2.9.0",
    "color-rgba": "^2.4.0",
    "lodash": "^4.17.21",
    "midi-parser-js": "^4.0.4"
  }
}
