{
    "fps": 30,
    "noteApproachTime": 1000,
    "midiFileName": "test-data/drums.mid",
    "width": 1280,
    "height": 720,
    "backgroundColor": "black",
    "flyIn": {
        "type": "3d",
        "shape": "bezierCurve",
        "startingPoint": {
            "x": 0.5,
            "y": 0.4,
            "oscillation": {
                "cycleLengthInSeconds": 20,
                "width": 0.8
            }
        }
    },
    "particles": {
        "perFrame": 50
    },
    "noteMap": {
        "36": "Kick 1",
        "35": "Kick 2",
        "38": "Snare",
        "57": "Crash Right",
        "55": "Crash Left",
        "60": "HH Closed Tight",
        "61": "HH Closed",
        "62": "HH Open 1",
        "63": "HH Open 2",
        "64": "HH Open ?",
        "65": "HH Open 3",
        "72": "HH Pedal"
    },
    "colorizer": {
        "type": "byNote",
        "defaultColor": "white",
        "noteColors": {
            "Kick 1": "red",
            "Kick 2": "maroon",
            "Snare": "white",
            "Crash Right": "cyan",
            "Crash Left": "cyan",
            "HH Closed Tight": "purple",
            "HH Closed": "purple",
            "HH Open 1": "#FF00FF",
            "HH Open 2": "#FF00FF",
            "HH Open 3": "#FF00FF",
            "HH Open ?": "#FF00FF",
            "HH Pedal": "purple"
        }
    },
    "visualizer": {
        "type": "drumPads",
        "padHeight": 200,
        "padY": 0,
        "padOrder": [
            ["Crash Left"],
            [
                "HH Closed Tight",
                "HH Closed",
                "HH Open 1",
                "HH Open 2",
                "HH Open 3",
                "HH Open ?",
                "HH Pedal"
            ],
            ["Kick 1", "Kick 2"],
            ["Snare"],
            ["Crash Right"]
        ],
        "impactSize": 75
    }
}